          </mxGeometry>
        </mxCell>
        <mxCell id="v52" value="&lt;b&gt;This is a callback - the control flow is inverted.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inside the loop the arrow points &lt;i&gt;from&lt;/i&gt; the library &lt;i&gt;into&lt;/i&gt; our own code: libcurl calls writeCallback, we never call it ourselves. It all happens during the single curl_easy_perform() call above.&lt;br&gt;&lt;br&gt;That is also why writeCallback has to be &lt;b&gt;static&lt;/b&gt;: libcurl expects a plain C function pointer, and those cannot carry a &amp;#8222;this&amp;#8220;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="660" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v53" value="&lt;b&gt;Why curl_easy_reset() first?&lt;/b&gt;&lt;br&gt;The same CURL* handle is reused for every request. Without the reset, options from the previous call would still be set - e.g. CURLOPT_NOBODY from connect(), which would suppress the listing we want here.&lt;br&gt;&lt;br&gt;&lt;b&gt;Compare with SFTP:&lt;/b&gt; there, sftp_readdir() returns structured attributes. Here the server sends one block of text that has to be parsed line by line." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" vertex="1" parent="1">
          <mxGeometry x="740" y="870" width="680" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 - host key check" id="3_-_host_key_check">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v54" value="verifyHostKey() - what happens for each possible state of the server&#39;s host key" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
