            <mxPoint x="675" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="verifyHostKey()   -&amp;gt;  see page 3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=11;align=left;verticalAlign=middle;strokeColor=#000000;labelBackgroundColor=#ffffff;" parent="1" edge="1">
