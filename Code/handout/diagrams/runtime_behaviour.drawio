        </mxCell>
        <mxCell id="v58" value="SSH_KNOWN_HOSTS_OK key known and unchanged" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
