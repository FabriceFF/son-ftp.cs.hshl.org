        </mxCell>
        <mxCell id="m15" value="server host key" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=10;dashed=1;rounded=0;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
