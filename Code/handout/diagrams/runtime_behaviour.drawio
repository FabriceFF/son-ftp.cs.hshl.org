            <mxPoint x="980" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m19" value="SSH_AUTH_SUCCESS" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=10;dashed=1;rounded=0;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="612" as="sourcePoint" />
            <mxPoint x="675" y="612" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v20" value="Step 2:  open the SFTP channel on top  [sftp_*]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;fontSize=11;fontStyle=1;align=left;verticalAlign=top;width=190;height=26;" parent="1" vertex="1">
          <mxGeometry x="250" y="640" width="870" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m21" value="sftp_new(session)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="680" as="sourcePoint" />
            <mxPoint x="675" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m22" value="sftp_init(sftp)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="716" as="sourcePoint" />
            <mxPoint x="675" y="716" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m23" value="open SFTP subsystem" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="675" y="748" as="sourcePoint" />
            <mxPoint x="980" y="748" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m24" value="return 0      // 0 == OK, NOT true!" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;endSize=10;dashed=1;rounded=0;fontSize=11;strokeColor=#555555;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="790" as="sourcePoint" />
            <mxPoint x="125" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v25" value="&lt;b&gt;Why two steps?&lt;/b&gt;&lt;br&gt;SFTP is not &amp;#8222;FTP with encryption&amp;#8220;. It is a file transfer channel that runs &lt;i&gt;inside&lt;/i&gt; an SSH connection. So an SSH session has to be built and authenticated first (step 1); only then can the SFTP channel be opened on top of it (step 2)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="830" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="&lt;b&gt;Every failure path cleans up.&lt;/b&gt;&lt;br&gt;If ssh_new, ssh_connect, verifyHostKey, ssh_userauth_password or sftp_new/sftp_init fails, connect() calls disconnect() and returns -1.&lt;br&gt;&lt;br&gt;disconnect() unwinds in &lt;b&gt;reverse&lt;/b&gt; order:&lt;br&gt;sftp_free &amp;#8594; ssh_disconnect &amp;#8594; ssh_free." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" parent="1" vertex="1">
          <mxGeometry x="580" y="830" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v27" value="&lt;b&gt;Security:&lt;/b&gt; the host key is checked &lt;i&gt;between&lt;/i&gt; ssh_connect() and ssh_userauth_password(). ssh_connect() does not do it for you - sending the password to an unverified server is exactly the man-in-the-middle case." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="1000" width="1060" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
