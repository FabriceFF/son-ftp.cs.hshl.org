          </mxGeometry>
        </mxCell>
        <mxCell id="m17" value="ssh_userauth_password(session, nullptr, password)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="542" as="sourcePoint" />
            <mxPoint x="675" y="542" as="targetPoint" />
          </mxGeometry>
        </mxCell>
