        <mxCell id="v63" value="show the fingerprint: ssh_get_server_publickey() ssh_get_publickey_hash(SHA256) ssh_get_fingerprint_hash()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="650" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v64" value="ssh_session_update_known_hosts()" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="790" width="300" height="50" as="geometry" />
        </mxCell>
