        </mxCell>
        <mxCell id="m14" value="TCP connect + SSH key exchange" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;endSize=8;rounded=0;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
