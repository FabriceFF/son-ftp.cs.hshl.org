          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v63" target="v64">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v64" target="v65">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v60" target="v66">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v61" target="v66">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f83" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v65" target="v67">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;fontSize=11;strokeColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v66" target="v68">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v85" value="&lt;b&gt;Trust On First Use (TOFU)&lt;/b&gt;&lt;br&gt;The &amp;#8222;yes&amp;#8220; branch is what ssh itself does the first time you connect to a machine: it shows the fingerprint and stores it.&lt;br&gt;&lt;br&gt;In this exercise acceptNewHostKey is true so the program runs without asking. &lt;b&gt;Real software must show the fingerprint and let a human confirm it&lt;/b&gt; - otherwise the check is worthless." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" vertex="1" parent="1">
          <mxGeometry x="1170" y="400" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="v86" value="&lt;b&gt;Why CHANGED is an abort, not a question&lt;/b&gt;&lt;br&gt;A key that changed means either the server was reinstalled - or somebody is sitting between you and the server and offering their own key. The program cannot tell the two apart, so it refuses to send the password." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;size=14;" vertex="1" parent="1">
          <mxGeometry x="1170" y="620" width="380" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
